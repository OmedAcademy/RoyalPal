# The Expo SDK 57 pins resolve react 19.2.3 while react-dom's published peer
# range asks for 19.3.0. npm 10 treats that as a hard failure, so a clean
# `npm ci` in CI dies on a mismatch that Metro never sees — the bundle takes
# react from this project's own copy (see metro.config.js).
#
# Set here rather than passed as a flag so the install behaves the same on a
# laptop, in CI, and in EAS Build, which runs its own install.
legacy-peer-deps=true
