# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# --- Supabase (introduced in M1) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Never expose via NEXT_PUBLIC_*, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (introduced in M8/M9) ---------------------------------------
#
# *** STILL PENDING — see docs/STRIPE_TEST_MODE_VERIFICATION.md ***
#
# The whole Stripe Connect surface is code-complete and unit-tested, but has
# NEVER run against real Stripe. Nothing here is configured yet.
#
# The app degrades gracefully with these unset: non-payment pages work
# normally, and every payment path returns a clear "temporarily unavailable"
# rather than crashing or blaming Stripe (see lib/stripe/client.ts's
# isStripeConfigured). Booking is refused BEFORE a row is inserted, so an
# unconfigured deployment never leaves orphaned pending_payment bookings.
#
# Use TEST-MODE values only (sk_test_ / pk_test_). This Stripe account is
# shared with a sibling product — a live key here would create real charges
# against a real business.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Printed by `stripe listen` — see the runbook, Phase 3. Leave empty until then.
STRIPE_WEBHOOK_SECRET=

# Platform commission in BASIS POINTS (1 bp = 0.01%). Optional.
# Unset = 10% (DEFAULT_PLATFORM_FEE_BPS in lib/pricing/commission.ts).
# A per-tutor override lives in tutor_profiles.platform_fee_bps and wins
# over this. A malformed value here is ignored rather than parsed loosely,
# so a typo cannot silently set the take rate to zero.
PLATFORM_FEE_BPS=

# --- Email (introduced in M14) -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Stripe: RoyalPal Product in the shared Lingora account ---------------
# Optional. One stable Product; without it, lessons use an ad-hoc tagged Product.
STRIPE_ROYALPAL_PRODUCT_ID=

# --- Google Meet / Calendar ------------------------------------------------
# Server-only; never exposed to the client. The Meet integration stays fully
# dormant (bookings still work, just without a video link) until CLIENT_ID,
# CLIENT_SECRET and REFRESH_TOKEN are all set.
#
# Auth model: ONE platform-owned Google account ("RoyalPal Operations") that
# owns every lesson event, with tutor + student added as attendees. This is a
# deliberate choice — RoyalPal's user login is Supabase email/password, NOT
# Google OAuth, so there is no per-user Google session to borrow. Authorize
# the ops account once to mint a long-lived refresh token; after that the
# server refreshes access tokens forever with no human involvement.
#
# OAuth client type: "Web application".
# Required scope: https://www.googleapis.com/auth/calendar.events
#
# GOOGLE_REDIRECT_URI is used ONLY by the one-time token-minting script
# (scripts/google-refresh-token.mjs) — the running app never performs an
# OAuth redirect, so this value does not need to be a live RoyalPal route.
# It must match a "Authorized redirect URI" in the Google Cloud console
# exactly. Recommended: http://localhost:3000/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Calendar the lesson events are created on. "primary" = the ops account's own
# calendar. Use a dedicated calendar's id to keep lessons separate.
GOOGLE_CALENDAR_ID=primary

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
